{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aphelocoma.dev/schemas/hamilton-implementer-result-v1.json",
  "title": "Hamilton implementer result",
  "description": "The exact JSON an implementer worker returns as its final message (PARALLEL.md §3). Passed to `codex exec --output-schema` so the CLI enforces the contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "role", "status", "artifacts", "events", "blocked_reason"],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "event": {
                  "const": "blocked"
                },
                "to": {
                  "type": "null"
                }
              },
              "required": ["event", "to", "note"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "in_review"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": "null"
          },
          "artifacts": {
            "type": "array",
            "minItems": 1
          },
          "events": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": [
              {
                "type": "object",
                "properties": {
                  "event": {
                    "const": "work_started"
                  },
                  "to": {
                    "type": "null"
                  }
                },
                "required": ["event", "to", "note"]
              },
              {
                "type": "object",
                "properties": {
                  "event": {
                    "const": "artifact_written"
                  },
                  "to": {
                    "type": "null"
                  }
                },
                "required": ["event", "to", "note"]
              },
              {
                "type": "object",
                "properties": {
                  "event": {
                    "const": "handoff"
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["event", "to", "note"]
              }
            ],
            "additionalItems": false
          }
        }
      }
    }
  ],
  "properties": {
    "task": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9._-]*$", "description": "The <task-id> this worker was dispatched for." },
    "role": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*(?:#[1-9][0-9]*)?$", "description": "The exact role/instance id, e.g. backend-developer or fullstack-developer#2." },
    "status": { "type": "string", "enum": ["in_review", "blocked"] },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "Project-relative paths of deliverables written (may be non-empty even when blocked)."
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "to", "note"],
        "properties": {
          "event": {
            "type": "string",
            "enum": ["work_started", "artifact_written", "handoff", "blocked", "assumption_logged"]
          },
          "to": { "type": ["string", "null"], "description": "Receiving role for handoff; null otherwise." },
          "note": { "type": "string", "minLength": 1 }
        }
      },
      "description": "Ledger entries for the orchestrator (the single writer) to serialize — the worker never writes events.jsonl itself."
    },
    "blocked_reason": { "type": ["string", "null"], "description": "Populated only when status is blocked." }
  }
}
